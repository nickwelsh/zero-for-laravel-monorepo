{
    "name": "@nickwelsh/zero-for-laravel",
    "version": "0.5.0",
    "description": "Controller-first Laravel queries, native Zero mutations, and React/Inertia bindings.",
    "homepage": "https://docs.nickwelsh.me/zero-for-laravel/",
    "bugs": {
        "url": "https://github.com/nickwelsh/zero-for-laravel-monorepo/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nickwelsh/zero-for-laravel-monorepo.git",
        "directory": "packages/client"
    },
    "files": [
        "dist",
        "LICENSE"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js"
        },
        "./inertia": {
            "types": "./dist/inertia.d.ts",
            "import": "./dist/inertia.js"
        },
        "./search": {
            "types": "./dist/search/index.d.ts",
            "import": "./dist/search/index.js"
        },
        "./react/search": {
            "types": "./dist/react/search.d.ts",
            "import": "./dist/react/search.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vp pack"
    },
    "dependencies": {
        "ulid": "^3.0.0",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@inertiajs/react": "^3.8.0",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "@inertiajs/react": "^3.8.0",
        "@rocicorp/zero": "1.11.3",
        "react": "^18.0.0 || ^19.0.0",
        "react-instantsearch": "^7.52.0",
        "typesense-instantsearch-adapter": "^3.0.2"
    },
    "peerDependenciesMeta": {
        "@inertiajs/react": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-instantsearch": {
            "optional": true
        },
        "typesense-instantsearch-adapter": {
            "optional": true
        }
    }
}
