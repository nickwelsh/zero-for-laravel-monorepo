{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@zero-for-laravel/example-todos",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "pnpm --workspace-root exec vp check examples/todos",
        "check:fix": "pnpm --workspace-root exec vp check --fix examples/todos",
        "types:check": "tsc --noEmit",
        "zero:generate": "php artisan zero:generate",
        "zero:dev": "node scripts/start-zero.mjs",
        "zero:check": "php artisan zero:generate --check"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.4.0",
        "@nickwelsh/zero-for-laravel": "workspace:*",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-toggle": "^1.2.1",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@rocicorp/zero": "1.10.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^0.475.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@rolldown/plugin-babel": "^0.2.3",
        "@types/node": "^26.6.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "vite-plus": "1.2.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.64.6",
        "@rollup/rollup-win32-x64-msvc": "4.64.6",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
