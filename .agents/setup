#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export DEBIAN_FRONTEND=noninteractive

step() {
    local started=$SECONDS
    printf '\n==> %s\n' "$*"
    "$@"
    printf '==> Finished in %ss\n' "$((SECONDS - started))"
}

# PHP 8.5 supports both the library and the example's Pest 5 dependencies.
packages=(ca-certificates curl unzip aspell aspell-en lsof build-essential python3
    postgresql postgresql-client php8.5-cli php8.5-curl php8.5-mbstring
    php8.5-pgsql php8.5-sqlite3 php8.5-xml php8.5-zip php8.5-bcmath php8.5-intl php8.5-xdebug)
missing=()
for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
        missing+=("$package")
    fi
done
if ((${#missing[@]})); then
    if [[ ! -f /etc/apt/sources.list.d/php.list ]]; then
        step sudo apt-get update -qq
        step sudo apt-get install -y --no-install-recommends ca-certificates curl
        keyring=$(mktemp)
        curl -fsSL https://packages.sury.org/debsuryorg-archive-keyring.deb -o "$keyring"
        step sudo dpkg -i "$keyring"
        rm -f "$keyring"
        echo 'deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ bookworm main' |
            sudo tee /etc/apt/sources.list.d/php.list > /dev/null
    fi
    step sudo apt-get update -qq
    step sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi
sudo update-alternatives --set php /usr/bin/php8.5

# Retain a compatible preinstalled Node; otherwise install the CI runtime line.
if ! command -v node >/dev/null || ! node -e '
    const [major, minor] = process.versions.node.split(".").map(Number);
    process.exit((major === 22 && minor >= 18) || (major === 24 && minor >= 11) || major > 24 ? 0 : 1);
'; then
    step sudo npm install --global node@24
fi
pnpm_version=$(node -p 'JSON.parse(require("fs").readFileSync("package.json")).packageManager.split("@")[1]')
if ! command -v pnpm >/dev/null || [[ $(pnpm --version) != "$pnpm_version" ]]; then
    step sudo npm install --global "pnpm@$pnpm_version"
fi
if ! command -v composer >/dev/null; then
    installer=$(mktemp)
    curl -fsSL https://getcomposer.org/installer -o "$installer"
    expected=$(curl -fsSL https://composer.github.io/installer.sig)
    [[ $(sha384sum "$installer" | cut -d ' ' -f 1) == "$expected" ]]
    step sudo php "$installer" --install-dir=/usr/local/bin --filename=composer --2
    rm -f "$installer"
fi

# This database is orb-local and disposable. Trust only the local test role,
# never remote connections; live tests also need database/replication privileges.
pg_version=$(ls /etc/postgresql | sort -V | tail -1)
pg_config="/etc/postgresql/$pg_version/main"
sudo tee "$pg_config/conf.d/amp-orb.conf" > /dev/null <<'EOF'
listen_addresses = '127.0.0.1'
wal_level = logical
fsync = off
synchronous_commit = off
full_page_writes = off
EOF
if ! sudo grep -Fqx '# Amp orb test connections' "$pg_config/pg_hba.conf"; then
    sudo sed -i '1i# Amp orb test connections\nhost all postgres 127.0.0.1/32 trust' "$pg_config/pg_hba.conf"
fi
step sudo systemctl enable --now postgresql
step sudo systemctl restart "postgresql@$pg_version-main"
if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname = 'laravel_zero_test'" | grep -qx 1; then
    step sudo -u postgres createdb laravel_zero_test
fi

# Login shells used by agents and supervised services inherit test settings.
profile_marker='# Zero for Laravel orb test environment'
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ "\$PWD" == "$PWD" || "\$PWD" == "$PWD/"* ]]; then
    export ZERO_TEST_PG_DATABASE=\${ZERO_TEST_PG_DATABASE:-laravel_zero_test}
    export ZERO_TEST_PG_HOST=\${ZERO_TEST_PG_HOST:-127.0.0.1}
    export ZERO_TEST_PG_USER=\${ZERO_TEST_PG_USER:-postgres}
fi
EOF
fi

step composer --working-dir=packages/laravel install --no-interaction --prefer-dist
step composer --working-dir=examples/todos install --no-interaction --prefer-dist
step pnpm install --frozen-lockfile
step php examples/todos/artisan wayfinder:generate --with-form
step pnpm --filter @nickwelsh/zero-for-laravel build
[[ -f examples/todos/.env ]] || cp -- examples/todos/.env.example examples/todos/.env
printf '\nOrb dependencies ready: Node %s, pnpm %s, PHP %s\n' \
    "$(node --version)" "$(pnpm --version)" "$(php -r 'echo PHP_VERSION;')"
