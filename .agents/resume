#!/usr/bin/env bash
set -euo pipefail

# Systemd owns PostgreSQL, so it survives setup and starts from snapshots.
# Repair a stopped database on wake without reinstalling dependencies.
if ! pg_isready -h 127.0.0.1 -p 5432 -q; then
    pg_version=$(ls /etc/postgresql | sort -V | tail -1)
    sudo systemctl start "postgresql@$pg_version-main"
fi
pg_isready -h 127.0.0.1 -p 5432
