{
    "name": "@zero-for-laravel/docs",
    "private": true,
    "type": "module",
    "scripts": {
        "api:generate": "refquill generate refquill.json",
        "api:validate": "refquill validate generated/api.json",
        "dev": "pnpm api:generate && docs-base dev",
        "build": "pnpm api:generate && docs-base build",
        "start": "docs-base start",
        "typecheck": "tsc --noEmit",
        "check": "pnpm api:validate && pnpm typecheck",
        "deploy:check": "vite build && cf deploy --prebuilt --mode production --dry-run",
        "deploy": "cf deploy --prebuilt --mode production"
    },
    "dependencies": {
        "@nickwelsh/docs-base": "^1.0.1",
        "fumadocs-core": "16.17.8",
        "fumadocs-mdx": "15.4.10",
        "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.5",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-server-dom-webpack": "19.3.1",
        "waku": "1.0.0-rc.3"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
        "@nickwelsh/refquill": "0.1.0",
        "@types/node": "^26.6.5",
        "cf": "1.0.0-beta.17",
        "typescript": "^6.0.2",
        "vite": "8.3.5"
    }
}
